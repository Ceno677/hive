NODE_ENV=production
PUBLIC_ORIGIN=https://hmd.bot
HIVE_API_URL=https://hmd.bot
WORKER_TOKEN=replace-after-agent-pairing
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-on-the-runner-only
AI_BUILDER_MODEL=replace-with-approved-builder-model
AI_REVIEWER_MODEL=replace-with-approved-reviewer-model
AI_API_STYLE=responses
AI_REASONING_EFFORT=high
AI_SERVICE_TIER=default
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_OUTPUT_TOKENS=32768
AI_MAX_INPUT_CHARS=600000
AI_MAX_RETRIES=3
AGENT_REPAIR_PASSES=4
EXECUTION_ENABLED=true
SANDBOX_IMAGE=hive-sandbox:local
RUST_SANDBOX_IMAGE=hive-rust-sandbox:local
ARTIFACT_STORAGE=s3
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=unused-by-worker
S3_ACCESS_KEY=unused-by-worker
S3_SECRET_KEY=unused-by-worker-runtime
OPERATIONS_TOKEN=worker-config-placeholder-not-used
TURNSTILE_SITE_KEY=worker-config-placeholder-not-used
TURNSTILE_SECRET_KEY=worker-config-placeholder-not-used
TRUST_PROXY=true
