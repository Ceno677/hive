FROM rust:1.85-bookworm AS rust
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}" RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
WORKDIR /work
COPY infra/docker/runner.cjs /runner/runner.cjs
COPY infra/docker/check-static.cjs /runner/check-static.cjs
USER node
ENTRYPOINT ["node", "/runner/runner.cjs"]
