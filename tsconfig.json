{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "types": ["node"], "noEmit": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "worker/**/*.ts", "infra/**/*.ts", "tests/**/*.ts", "site/client.ts"]
}
