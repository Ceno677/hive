NODE_ENV=development
PORT=4320
PUBLIC_ORIGIN=http://localhost:4320
DATABASE_URL=postgresql://hive:hive_local_only@localhost:5434/hive
REDIS_URL=redis://localhost:6381
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_BACKUP_RPC_URL=
SOLANA_CLUSTER=devnet
PAYMENT_MODE=custodial
# Set these after deploying/configuring programs. No real addresses are assumed.
HMD_MINT=
SEAT_COLLECTION_ADDRESS=
HIVE_PROGRAM_ID=
# Approved mint price: 8,888 HMD. Set base units only after reading mint decimals.
# Example ONLY: 6 decimals => 8888000000; 9 decimals => 8888000000000.
HMD_BURN_AMOUNT=
# Required launch decision: fixed delivery deadline shown before payment (1-168 hours).
JOB_DEADLINE_HOURS=
# Every job is scoped by AI, benchmarked as human market work, then charged at 50%.
JOB_PRICE_MARKET_BPS=5000
JOB_MIN_PRICE_USD=25
JOB_MAX_PRICE_USD=10000
# Short locks prevent stale quotes during launch volatility.
JOB_QUOTE_TTL_SECONDS=300
# Quotes fail closed if HMD liquidity is weak or material pools disagree.
HMD_PRICE_MIN_LIQUIDITY_USD=10000
HMD_PRICE_MAX_DEVIATION_BPS=1500
# A job quote may not exceed 5% of observed aggregate HMD liquidity.
HMD_PRICE_MAX_QUOTE_LIQUIDITY_BPS=500
HMD_PRICE_CACHE_SECONDS=20
# Explicit launch price for a brand-new HMD mint before DEX discovery exists.
# Quotes expose source=manual. Remove this once reliable DEX pricing exists.
HMD_MANUAL_PRICE_USD=
# Staging/devnet only: fixed test-token price so an unlisted test CA can exercise the full flow.
# Configuration rejects this value on mainnet-beta.
DEVNET_TEST_HMD_PRICE_USD=
BUILDER_BPS=
VERIFIER_BPS=
TREASURY_WALLET=
SIGNER_KEYPAIR_PATH=
CUSTODY_KEYPAIR_PATH=
# Railway-friendly alternative: JSON byte array or base58 secret. Set one custody option, never both.
CUSTODY_KEYPAIR_SECRET=
MINT_BASE_URI=
MAX_SEATS_PER_WALLET=2
# Select these policies explicitly before enabling payments; supported values below.
SETTLEMENT_POLICY=
# final-release: rewards vest after final validation, full refund before vesting.
GAS_POLICY=
# user-pays: users approve network fees. Gas sponsorship is not enabled.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Optional per-role overrides; no automatic downgrade to a cheaper model.
AI_PLANNER_MODEL=
# Pricing uses a focused low-cost model; builder/reviewer quality models remain unchanged.
AI_PRICING_MODEL=gpt-6-luna
AI_PRICING_REASONING_EFFORT=low
AI_BUILDER_MODEL=
AI_REVIEWER_MODEL=
AI_FINAL_MODEL=
# OpenAI's Responses API is recommended for the configured GPT-6 roles.
AI_API_STYLE=responses
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_OUTPUT_TOKENS=32768
AI_MAX_INPUT_CHARS=600000
AI_MAX_RETRIES=3
AI_REASONING_EFFORT=high
AI_SERVICE_TIER=default
# Every job quote researches current public market benchmarks through the Responses API.
# Bounded repairs, not unlimited spending. Range 1-8.
AGENT_REPAIR_PASSES=4
# Independent accepted reviews required for every task (1-3).
REVIEW_QUORUM=2
# Bayesian-smoothed quality gates apply only after this many decisions.
WORKER_REPUTATION_SAMPLE=5
BUILDER_MIN_REPUTATION=0.5
VERIFIER_MIN_REPUTATION=0.5
# Bounds NFT-transfer revocation latency and RPC load (15-300 seconds).
OWNERSHIP_RECHECK_SECONDS=60
DEADLINE_WARNING_MINUTES=60
AI_PROVIDER=openai-compatible
SANDBOX_IMAGE=hive-sandbox:local
EXECUTION_ENABLED=false
# When the scheduler cannot run Docker (for example Railway), point it at the authenticated runner.
EXECUTION_URL=
EXECUTION_TOKEN=
S3_ENDPOINT=http://localhost:9000
# local for development; s3 for production. End users install nothing.
ARTIFACT_STORAGE=local
S3_REGION=us-east-1
S3_BUCKET=hive-artifacts
S3_ACCESS_KEY=hive_local
S3_SECRET_KEY=hive_local_secret_change_me
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Railway-friendly alternative to the file path. Multiline PEM or escaped \n form.
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
GITHUB_ALLOWED_OWNER=
# Optional staged devnet program + website publishing. Ordinary GitHub builds do not require it.
SOLANA_RELEASES_ENABLED=false
# Secret with 32+ random characters; derives a stable, distinct program address per workflow.
DEPLOY_PROGRAM_SEED=
SOLANA_BUILD_IMAGE=
RUST_SANDBOX_IMAGE=
OPERATIONS_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional separately funded holder pool. Successful job fees are burned, not distributed.
HOLDER_DISTRIBUTIONS_ENABLED=false
HOLDER_DISTRIBUTION_INTERVAL_HOURS=72
# Optional minimum in raw HMD base units. Leave empty to distribute any positive amount.
HOLDER_DISTRIBUTION_MIN_AMOUNT=
# Must support the Solana DAS getAssetsByGroup method; defaults to SOLANA_RPC_URL.
HOLDER_SNAPSHOT_RPC_URL=
TRUST_PROXY=false
NFT_IMAGE_BASE_URI=
NFT_METADATA_BASE_URI=
NFT_EXTERNAL_URL=
NFT_RELEASE_DIR=publication
# One-time collection creation. Generate these keypairs securely; never commit or paste them.
COLLECTION_AUTHORITY_KEYPAIR_PATH=
COLLECTION_MINT_KEYPAIR_PATH=
COLLECTION_METADATA_URI=
# Permanent Arweave uploads. Quote mode never spends; execute mode is capped.
TURBO_WALLET_KEYPAIR_PATH=
TURBO_GATEWAY=https://arweave.net
TURBO_FAST_GATEWAY=https://turbo-gateway.com
TURBO_MAX_IMAGE_SOL=0.045
TURBO_MAX_METADATA_SOL=0.005
CONFIRM_TURBO_UPLOAD=
# Required only for an intentional mainnet collection creation transaction.
CONFIRM_MAINNET_COLLECTION_CREATE=
HMD_BINDING_OUTPUT=.hive/hmd-binding.env
CONFIRM_MAINNET_PROTOCOL_INITIALIZE=
CONFIRM_MAINNET_COLLECTION_DELEGATE=
CONFIRM_MAINNET_PROTOCOL_ADMIN=
HIVE_PAUSED=true
# NFT holder/operator pairing: npm run agent:pair. Customers use the website and must hold at least one collection NFT to request a build.
HIVE_API_URL=http://localhost:4320
HOLDER_WALLET_KEYPAIR_PATH=
HOLDER_SEAT_ID=
WORKER_TOKEN=
WORKER_NAME=my-agent
WORKER_CAPABILITIES=html,typescript
WORKER_MAX_CONCURRENT=1
WORKER_PUBLIC=false
RUNTIME_URL=
