{
  "name": "hive-md",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "hive.md / $HMD — Solana agent network frontend and approved 888 NFT studio",
  "scripts": {
    "build": "node nft-source/verify-lock.mjs && node --check site/app.js && node --check site/studio/studio.js && node --check site/dashboard.js && node --check site/backend.js",
    "verify:collection": "node nft-source/verify-lock.mjs",
    "dev": "tsx watch apps/api/main.ts",
    "start": "tsx apps/api/main.ts",
    "scheduler": "tsx apps/scheduler/main.ts",
    "executor": "tsx apps/executor/main.ts",
    "worker": "tsx worker/daemon/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema packages/database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/schema.prisma",
    "db:seed": "tsx infra/scripts/seed.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "build:client": "esbuild site/client.ts --bundle --format=iife --platform=browser --outfile=site/backend.js --minify",
    "test:integration": "tsx infra/scripts/test-integration.ts",
    "test:integration:db": "tsx infra/scripts/test-integration.ts --skip-sandbox",
    "test:integration:railway": "tsx infra/scripts/test-integration-railway.ts",
    "storage:init": "tsx infra/scripts/storage.ts",
    "storage:smoke": "tsx infra/scripts/test-storage.ts",
    "test:program": "docker run --rm -v .:/workspace -v hive_cargo:/usr/local/cargo/registry -v hive_rust_target:/workspace/target -w /workspace rust:1.85-bookworm cargo test -p hive --locked --quiet",
    "test:browser": "tsx infra/scripts/browser-smoke.ts",
    "agent:enroll": "tsx infra/scripts/enroll-hosted-agent.ts",
    "agent:pair": "tsx infra/scripts/enroll-hosted-agent.ts",
    "metadata:export": "tsx infra/scripts/export-metadata.ts",
    "nft:prepare": "tsx infra/scripts/export-metadata.ts",
    "nft:verify": "tsx infra/scripts/verify-nft-release.ts",
    "nft:verify:remote": "tsx infra/scripts/verify-nft-remote.ts",
    "nft:verify:remote:fast": "tsx infra/scripts/verify-nft-remote.ts --fast",
    "nft:upload": "tsx infra/scripts/upload-nft-assets.ts",
    "nft:upload:images": "tsx infra/scripts/upload-nft-assets.ts images",
    "nft:upload:images:execute": "tsx infra/scripts/upload-nft-assets.ts images --execute",
    "nft:upload:metadata": "tsx infra/scripts/upload-nft-assets.ts metadata",
    "nft:upload:metadata:execute": "tsx infra/scripts/upload-nft-assets.ts metadata --execute",
    "nft:collection:create": "tsx infra/scripts/create-collection.ts",
    "nft:bind-hmd": "tsx infra/scripts/bind-hmd-token.ts",
    "protocol:initialize": "tsx infra/scripts/initialize-protocol.ts",
    "protocol:collection:delegate": "tsx infra/scripts/delegate-collection.ts",
    "protocol:pause": "tsx infra/scripts/set-protocol-pause.ts",
    "launch:check": "tsx infra/scripts/launch-check.ts",
    "pricing:smoke": "tsx infra/scripts/test-pricing-model.ts",
    "test:agent:benchmark": "tsx infra/scripts/test-agent-benchmark.ts",
    "test:agent:browser": "tsx infra/scripts/test-benchmark-browser.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.6.0",
    "@octokit/auth-app": "^8.3.1",
    "@prisma/client": "^6.19.3",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "bullmq": "^5.81.5",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@ardrive/turbo-sdk": "^2.1.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "jayson": "^5.0.0"
  }
}
